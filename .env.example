# Supabase Configuration
# Replace with your actual project URL and public anon key from the Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service Role Key for running admin/sync scripts (scripts/upload-audio.mjs)
# Found in Project Settings -> API -> Project API keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
